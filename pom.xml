	<profiles>
		<profile>
			<id>dev</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<properties>
				<maven.profile.name>Development</maven.profile.name>
				<spring.profiles.active>development</spring.profiles.active>
				<spring.profiles.surefire.skip.test.unit>false</spring.profiles.surefire.skip.test.unit>

				<log4j2.logfile.pathname>./logs/application</log4j2.logfile.pathname>
				<log4j2.logfile.logline> %clr{#%-4L}</log4j2.logfile.logline>
				<log4j2.logfile.append>false</log4j2.logfile.append>
				<log4j2.logfile.immediateFlush>true</log4j2.logfile.immediateFlush>
				<log4j2.logfile.ignoreExceptions>true</log4j2.logfile.ignoreExceptions>
				<log4j2.logfile.monitorInterval>10</log4j2.logfile.monitorInterval>
				<log4j2.logfile.policy.onStartUp.size>1</log4j2.logfile.policy.onStartUp.size>
				<log4j2.logfile.policy.sizeBased.size>16384 MB</log4j2.logfile.policy.sizeBased.size>
				<log4j2.logfile.policy.timeBased.interval>1</log4j2.logfile.policy.timeBased.interval>
				<log4j2.logfile.policy.timeBased.modulate>false</log4j2.logfile.policy.timeBased.modulate>
				<log4j2.logfile.thresholdFilter>ALL</log4j2.logfile.thresholdFilter>
				<log4j2.console.thresholdFilter>ALL</log4j2.console.thresholdFilter>
				<log4j2.info.hersche.document.metadata>ALL</log4j2.info.hersche.document.metadata>
			</properties>
		</profile>

		<profile>
			<id>qas</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<properties>
				<maven.profile.name>QAS</maven.profile.name>
				<spring.profiles.active>QAS</spring.profiles.active>
				<spring.profiles.surefire.skip.test.unit>false</spring.profiles.surefire.skip.test.unit>

				<log4j2.logfile.pathname>./logs/application</log4j2.logfile.pathname>
				<log4j2.logfile.logline> %clr{#%-4L}</log4j2.logfile.logline>
				<log4j2.logfile.append>false</log4j2.logfile.append>
				<log4j2.logfile.immediateFlush>true</log4j2.logfile.immediateFlush>
				<log4j2.logfile.ignoreExceptions>true</log4j2.logfile.ignoreExceptions>
				<log4j2.logfile.monitorInterval>10</log4j2.logfile.monitorInterval>
				<log4j2.logfile.policy.onStartUp.size>1</log4j2.logfile.policy.onStartUp.size>
				<log4j2.logfile.policy.sizeBased.size>16384 MB</log4j2.logfile.policy.sizeBased.size>
				<log4j2.logfile.policy.timeBased.interval>1</log4j2.logfile.policy.timeBased.interval>
				<log4j2.logfile.policy.timeBased.modulate>false</log4j2.logfile.policy.timeBased.modulate>
				<log4j2.logfile.thresholdFilter>ALL</log4j2.logfile.thresholdFilter>
				<log4j2.console.thresholdFilter>ALL</log4j2.console.thresholdFilter>
				<log4j2.info.hersche.document.metadata>ALL</log4j2.info.hersche.document.metadata>
			</properties>
		</profile>

		<profile>
			<id>prod</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<maven.profile.name>Productive</maven.profile.name>
				<spring.profiles.active>productive</spring.profiles.active>
				<spring.profiles.surefire.skip.test.unit>true</spring.profiles.surefire.skip.test.unit>

				<log4j2.logfile.pathname>./logs/application</log4j2.logfile.pathname>
